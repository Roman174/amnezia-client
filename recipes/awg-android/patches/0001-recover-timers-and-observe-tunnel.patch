diff --git a/device/probe.go b/device/probe.go
new file mode 100644
index 0000000..6b8b954
--- /dev/null
+++ b/device/probe.go
@@ -0,0 +1,35 @@
+package device
+
+import (
+	"errors"
+	"time"
+)
+
+func (device *Device) Probe() (time.Duration, error) {
+	if !device.isUp() {
+		return 0, errors.New("device is down")
+	}
+	device.peers.RLock()
+	peers := make([]*Peer, 0, len(device.peers.keyMap))
+	for _, peer := range device.peers.keyMap {
+		peers = append(peers, peer)
+	}
+	device.peers.RUnlock()
+	if len(peers) == 0 {
+		return 0, errors.New("device has no peers")
+	}
+	var wait time.Duration
+	for _, peer := range peers {
+		peer.handshake.mutex.RLock()
+		remaining := device.rekeyMinTimeout() - time.Since(peer.handshake.lastSentHandshake)
+		peer.handshake.mutex.RUnlock()
+		if remaining > 0 {
+			wait = max(wait, remaining)
+			continue
+		}
+		if err := peer.SendHandshakeInitiation(false); err != nil {
+			return 0, err
+		}
+	}
+	return wait, nil
+}
diff --git a/device/timers_recovery_test.go b/device/timers_recovery_test.go
new file mode 100644
index 0000000..ea5f3db
--- /dev/null
+++ b/device/timers_recovery_test.go
@@ -0,0 +1,90 @@
+package device
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestTimerExpiryRace(t *testing.T) {
+	var peer Peer
+	timer := peer.NewTimer(func(*Peer, time.Duration) {})
+	defer timer.DelSync()
+	deadline := time.Now().Add(5 * time.Second)
+	for i := 0; i < 100; i++ {
+		timer.Mod(time.Microsecond)
+		for timer.IsPending() {
+			if time.Now().After(deadline) {
+				t.Fatal("timer did not expire")
+			}
+		}
+	}
+}
+
+func TestTimerZeroDurationAndRearm(t *testing.T) {
+	var peer Peer
+	expired := make(chan time.Duration, 2)
+	timer := peer.NewTimer(func(_ *Peer, d time.Duration) { expired <- d })
+	defer timer.DelSync()
+	for _, duration := range []time.Duration{0, time.Millisecond} {
+		timer.Mod(duration)
+		select {
+		case got := <-expired:
+			if got != duration {
+				t.Fatalf("duration = %v, want %v", got, duration)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("timer did not expire")
+		}
+	}
+	timer.Mod(time.Hour)
+	timer.DelSync()
+	if timer.IsPending() {
+		t.Fatal("deleted timer is pending")
+	}
+}
+
+func TestRecoveryProbeAndTelemetry(t *testing.T) {
+	pair := genTestPair(t, false)
+	device := pair[0].dev
+	device.peers.RLock()
+	var remote *Peer
+	for _, peer := range device.peers.keyMap {
+		remote = peer
+		break
+	}
+	device.peers.RUnlock()
+	if remote == nil {
+		t.Fatal("missing peer")
+	}
+	if wait, err := device.Probe(); err != nil || wait != 0 {
+		t.Fatalf("probe failed: %v, wait %v", err, wait)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for remote.lastHandshakeNano.Load() == 0 {
+		if time.Now().After(deadline) {
+			t.Fatal("probe handshake did not complete")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if remote.tunTxBytes.Load() != 0 {
+		t.Fatal("handshake counted as application traffic")
+	}
+	if wait, err := device.Probe(); err != nil || wait <= 0 {
+		t.Fatal("probe did not report its cooldown")
+	}
+	pair.Send(t, Pong, nil)
+	if remote.tunTxBytes.Load() == 0 {
+		t.Fatal("application demand not counted")
+	}
+	config, err := device.IpcGet()
+	if err != nil || !strings.Contains(config, "tun_tx_bytes=") || !strings.Contains(config, "tx_errors=") {
+		t.Fatal("missing recovery telemetry")
+	}
+	if err := device.Down(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := device.Probe(); err == nil {
+		t.Fatal("down device accepted probe")
+	}
+}
