+//export awgProbe
+func awgProbe(tunnelHandle int32) int32 {
+	handle, ok := tunnelHandles[tunnelHandle]
+	if !ok {
+		return -1
+	}
+	wait, err := handle.device.Probe()
+	if err != nil {
+		return -1
+	}
+	return int32((wait + time.Millisecond - 1) / time.Millisecond)
+}
