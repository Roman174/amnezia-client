+//export awgSetConfig
+func awgSetConfig(tunnelHandle int32, settings string) int32 {
+	handle, ok := tunnelHandles[tunnelHandle]
+	if !ok {
+		return -1
+	}
+	if err := handle.device.IpcSet(settings); err != nil {
+		return -1
+	}
+	return 0
+}
